{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node"],
    "baseUrl": "./webapp"
  },
  "include": [
    "shared/tabletennis/*.ts",
    "webapp/src/games/tabletennis/*.ts",
    "webapp/src/games/tabletennis/*.tsx"
  ]
}
