# Copy this file to `.env` and replace the values as needed.
# Telegram bot token
BOT_TOKEN=your-telegram-bot-token

# MongoDB connection string
# Use `memory` to run an in-memory database (for testing/dev only)
# Provide a real connection string in production to avoid falling back to the in-memory server
MONGO_URI=mongodb://localhost:27017/tonplaygram

# Compact connection defaults for the social wall. A small idle pool and wire
# compression keep RAM/network use bounded while still allowing concurrent posts.
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=0
MONGO_MAX_IDLE_TIME_MS=60000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_ZLIB_COMPRESSION_LEVEL=6

# Wall photos and videos are stored durably in MongoDB GridFS by default.
# Set to false only when FLAMINGO_UPLOAD_DIR is a separately backed-up,
# permanent volume and MongoDB storage is intentionally not desired.
FLAMINGO_GRIDFS_BACKUP=true

# `npm run reset-social-wall` removes every wall post by default. Set an ISO
# timestamp only when you intentionally want to preserve newer posts.
# SOCIAL_WALL_CUTOFF=2026-09-06T00:00:00.000Z
# Set false only if the MongoDB host does not permit the compact command.
SOCIAL_WALL_COMPACT=true

# API port (defaults to 3000 if not set)
PORT=3000

# Allowed origins for CORS and Socket.IO (comma-separated)
ALLOWED_ORIGINS=https://tonplaygram-bot.onrender.com,https://t.me,https://web.telegram.org

# Base URL passed to the webapp build when compiling on the server (optional)
WEBAPP_API_BASE_URL=

# Rate limit configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Comma-separated list of admin tokens for the airdrop API.
# These tokens also authorize access to the /api/broadcast route.
# AIRDROP_ADMIN_TOKENS=token1,token2
TWITTER_BEARER_TOKEN=your-twitter-bearer-token # remove the # to enable retweet verification
TWITTER_CLIENT_ID=your-twitter-api-key
TWITTER_CLIENT_SECRET=your-twitter-api-secret
# Enable OAuth routes for linking X (Twitter) accounts
ENABLE_TWITTER_OAUTH=false


# TON deposit address that users will send funds to when topping up their
# off-chain TPG balance
# Example: EQCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DEPOSIT_WALLET_ADDRESS=
# TON address that receives payments for store bundles
STORE_DEPOSIT_ADDRESS=UQAPwsGyKzA4MuBnCflTVwEcTLcGS9yV6okJWQGzO5VxVYD1

# Account IDs that receive developer fees
# Primary developer account (Tur.Alimadhi)
DEV_ACCOUNT_ID=5ffe7c43-c0ae-48f6-ab8c-9e065ca95466
# Optional additional developer accounts
DEV_ACCOUNT_ID_1=
DEV_ACCOUNT_ID_2=
# TON RPC endpoint for claim transactions (optional)
RPC_URL=https://toncenter.com/api/v2/jsonRPC

# Address of the deployed tpc_claim_wallet contract
CLAIM_CONTRACT_ADDRESS=

# Seed phrase of the admin wallet that signs claim transactions
CLAIM_WALLET_MNEMONIC=

# Jetton root address used to import TPG in wallets
TPC_JETTON_ADDRESS=EQDY3qbfGN6IMI5d4MsEoprhuMTz09OkqjyhPKX6DVtzbi6X
DEV_ACCOUNT_ID=5ffe7c43-c0ae-48f6-ab8c-9e065ca95466
SOCIAL_PROVIDER_MODE=mock
# Mock controls: success, retryable_failure, permanent_failure, auth_failure
SOCIAL_MOCK_FACEBOOK_RESULT=success
# Production provider adapters will require each provider's OAuth client ID,
# client secret and redirect URI. Tokens must be stored encrypted server-side.
# Keep the first Android/iOS store release free-play. This server gate blocks
# deposit addresses, balance-credit deposits, withdrawals, and external claims.
MOBILE_STORE_MODE=true
WITHDRAW_ENABLED=false

# User-facing Creator Studio: optional, isolated from SOCIAL_PROVIDER_MODE.
# See docs/creator-studio.md. Missing values disable only the relevant actions.
CREATOR_PUBLIC_URL=https://tonplaygram-bot.onrender.com
# Optional override: 32 random bytes encoded as base64, kept server-only.
# Otherwise Studio creates one private key on FLAMINGO_PERSISTENT_MOUNT_PATH.
# Back up the key with the disk. Replacing it invalidates saved sessions/grants.
CREATOR_ENCRYPTION_KEY=
CREATOR_MEDIA_DIR=/var/data/tonplaygram/creator-media
CREATOR_META_VERSION=v25.0
# Basic Google sign-in reuses GOOGLE_CLIENT_ID or VITE_GOOGLE_CLIENT_ID; no secret needed.
# YouTube needs the dedicated Google pair below, or GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET.
# Facebook/Instagram/TikTok also accept existing server app pairs; see docs/creator-studio.md.
CREATOR_GOOGLE_CLIENT_ID=
CREATOR_GOOGLE_CLIENT_SECRET=
CREATOR_META_CLIENT_ID=
CREATOR_META_CLIENT_SECRET=
CREATOR_INSTAGRAM_CLIENT_ID=
CREATOR_INSTAGRAM_CLIENT_SECRET=
CREATOR_TIKTOK_CLIENT_ID=
CREATOR_TIKTOK_CLIENT_SECRET=
# Enable only after Direct Post audit AND media URL-prefix ownership verification.
CREATOR_TIKTOK_APPROVED=false
# Enable after an unlisted live smoke test and a Render CPU/memory capacity check.
CREATOR_LIVE_ENABLED=false
CREATOR_LIVE_MAX_SESSIONS=1
